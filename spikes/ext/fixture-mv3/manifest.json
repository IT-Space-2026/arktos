{
  "manifest_version": 3,
  "name": "arora-ext-spike",
  "version": "0.1",
  "description": "EXT13 hosted-background fixture",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "sw.js" },
  "action": { "default_title": "spike", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["cs.js"],
      "run_at": "document_idle"
    }
  ]
}
