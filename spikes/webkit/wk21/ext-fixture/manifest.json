{
    "manifest_version": 3,
    "name": "WK21 Probe Extension",
    "version": "1.0",
    "description": "Minimal manifest for the WK21 webkit_web_extension_new probe.",
    "permissions": ["storage", "activeTab"],
    "host_permissions": ["*://*.test/*"],
    "action": { "default_title": "wk21" },
    "background": { "service_worker": "bg.js" },
    "content_scripts": [{
        "matches": ["*://*.test/*"],
        "js": ["cs.js"]
    }]
}
