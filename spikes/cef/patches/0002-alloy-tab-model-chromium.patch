+// Returns true if the Alloy style window |controller| matches the window-level
+// constraints of the query. Alloy windows have no BrowserWindowInterface, so
+// matching goes through their WindowController directly. |alloy_current| is
+// the controller hosting the calling extension context, if any.
+bool TabsQueryFunction::MatchesAlloyWindow(
+    WindowController* controller,
+    WindowController* alloy_current,
+    const std::string& target_window_type,
+    int target_window_id) {
+  Profile* candidate_profile = controller->profile();
+  Profile* profile = Profile::FromBrowserContext(browser_context());
+  if (!profile->IsSameOrParent(candidate_profile)) {
+    return false;
+  }
+  if (!include_incognito_information() && profile != candidate_profile) {
+    return false;
+  }
+
+  if (!controller->IsVisibleToTabsAPIForExtension(
+          extension(), /*include_dev_tools_windows=*/false)) {
+    return false;
+  }
+
+  // Note: `target_window_id` may be -1 or -2, which indicate unknown and
+  // current windows.
+  if (target_window_id >= 0 && target_window_id != controller->GetWindowId()) {
+    return false;
+  }
+
+  if (target_window_id == extension_misc::kCurrentWindowId &&
+      controller != alloy_current) {
+    return false;
+  }
+
+  if (!MatchesBool(query_info_.current_window,
+                   controller == alloy_current)) {
+    return false;
+  }
+
+  if (!MatchesBool(query_info_.last_focused_window,
+                   controller == cef::LastFocusedAlloyWindowController(
+                                     browser_context()))) {
+    return false;
+  }
+
+  if (!target_window_type.empty() &&
+      target_window_type != controller->GetWindowTypeText()) {
+    return false;
+  }
+
+  return true;
+}
+
+// Returns true if the Alloy style tab |web_contents| matches the tab-level
+// constraints of the query. Mirrors MatchesTab() for WebContents-level state;
+// Alloy browsers are single-tab, so the tab is always the active/selected tab
+// in its window and never pinned, grouped or split. Lifecycle states
+// (frozen/discarded) do not exist without a TabLifecycleUnit.
+bool TabsQueryFunction::MatchesAlloyTab(
+    content::WebContents* web_contents,
+    const URLPatternSet& target_url_patterns) {
+  if (!MatchesBool(query_info_.highlighted, true) ||
+      !MatchesBool(query_info_.active, true) ||
+      !MatchesBool(query_info_.pinned, false)) {
+    return false;
+  }
+
+  if (query_info_.group_id.has_value() &&
+      query_info_.group_id.value() != -1) {
+    return false;
+  }
+  if (query_info_.split_view_id.has_value() &&
+      query_info_.split_view_id.value() != -1) {
+    return false;
+  }
+
+  auto* audible_helper = RecentlyAudibleHelper::FromWebContents(web_contents);
+  if (!MatchesBool(query_info_.audible,
+                   audible_helper && audible_helper->WasRecentlyAudible())) {
+    return false;
+  }
+
+  if (!MatchesBool(query_info_.frozen, false) ||
+      !MatchesBool(query_info_.discarded, false) ||
+      !MatchesBool(query_info_.auto_discardable, true)) {
+    return false;
+  }
+
+  if (!MatchesBool(query_info_.muted, web_contents->IsAudioMuted())) {
+    return false;
+  }
+
+  bool check_title = query_info_.title && !query_info_.title->empty();
+  if (check_title || !target_url_patterns.is_empty()) {
+    // "title" and "url" properties are considered privileged data and can
+    // only be checked if the extension has the "tabs" permission or it has
+    // access to the WebContents's origin. Otherwise, this tab is considered
+    // not matched.
+    if (!extension_->permissions_data()->HasAPIPermissionForTab(
+            ExtensionTabUtil::GetTabId(web_contents),
+            mojom::APIPermissionID::kTab) &&
+        !extension_->permissions_data()->HasHostPermission(
+            web_contents->GetURL())) {
+      return false;
+    }
+
+    if (check_title &&
+        !base::MatchPattern(web_contents->GetTitle(),
+                            base::UTF8ToUTF16(*query_info_.title))) {
+      return false;
+    }
+
+    if (!target_url_patterns.is_empty() &&
+        !target_url_patterns.MatchesURL(web_contents->GetURL())) {
+      return false;
+    }
+  }
+
+  if (query_info_.status != tabs::TabStatus::kNone &&
+      query_info_.status != ExtensionTabUtil::GetLoadingStatus(web_contents)) {
+    return false;
+  }
+
+  return true;
+}
