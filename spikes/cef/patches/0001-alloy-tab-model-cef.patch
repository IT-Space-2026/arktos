+
+namespace cef {
+
+namespace {
+
+constexpr char kAlwaysOnTopKey[] = "alwaysOnTop";
+constexpr char kFocusedKey[] = "focused";
+constexpr char kHeightKey[] = "height";
+constexpr char kIncognitoKey[] = "incognito";
+constexpr char kLeftKey[] = "left";
+constexpr char kShowStateKey[] = "state";
+constexpr char kTopKey[] = "top";
+constexpr char kWidthKey[] = "width";
+constexpr char kWindowTypeKey[] = "type";
+constexpr char kShowStateValueNormal[] = "normal";
+
+// Tracks the most recently focused Alloy window controller. Cleared by the
+// controller on destruction.
+AlloyExtensionWindowController*& LastFocused() {
+  static AlloyExtensionWindowController* last_focused = nullptr;
+  return last_focused;
+}
+
+extensions::TabsEventRouter* TabsEventRouterFor(Profile* profile) {
+  if (auto* api = extensions::TabsWindowsAPI::Get(profile)) {
+    return api->tabs_event_router();
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+// AlloyBaseWindow:
+
+AlloyBaseWindow::AlloyBaseWindow(AlloyBrowserHostImpl* browser)
+    : browser_(browser) {}
+
+bool AlloyBaseWindow::IsActive() const {
+  return focused_;
+}
+
+bool AlloyBaseWindow::IsMaximized() const {
+  return false;
+}
+
+bool AlloyBaseWindow::IsMinimized() const {
+  return false;
+}
+
+bool AlloyBaseWindow::IsFullscreen() const {
+  return false;
+}
+
+gfx::NativeWindow AlloyBaseWindow::GetNativeWindow() const {
+  // Alloy windows are not aura::Window backed.
+  return nullptr;
+}
+
+gfx::Rect AlloyBaseWindow::GetRestoredBounds() const {
+  return GetBounds();
+}
+
+ui::mojom::WindowShowState AlloyBaseWindow::GetRestoredState() const {
+  return ui::mojom::WindowShowState::kNormal;
+}
+
+gfx::Rect AlloyBaseWindow::GetBounds() const {
+  if (auto* web_contents = browser_->GetWebContents()) {
+    return web_contents->GetContainerBounds();
+  }
+  return gfx::Rect();
+}
+
+void AlloyBaseWindow::Show() {
+  if (auto* delegate = browser_->platform_delegate()) {
+    delegate->WasHidden(false);
+  }
+}
+
+void AlloyBaseWindow::Hide() {
+  if (auto* delegate = browser_->platform_delegate()) {
+    delegate->WasHidden(true);
+  }
+}
+
+bool AlloyBaseWindow::IsVisible() const {
+  if (auto* delegate = browser_->platform_delegate()) {
+    return !delegate->IsHidden();
+  }
+  return true;
+}
+
+void AlloyBaseWindow::ShowInactive() {
+  Show();
+}
+
+void AlloyBaseWindow::Close() {
+  browser_->CloseBrowser(/*force_close=*/true);
+}
+
+void AlloyBaseWindow::Activate() {
+  browser_->SetFocus(true);
+}
+
+void AlloyBaseWindow::Deactivate() {
+  browser_->SetFocus(false);
+}
+
+void AlloyBaseWindow::Maximize() {
+  NOTIMPLEMENTED();
+}
+
+void AlloyBaseWindow::Minimize() {
+  NOTIMPLEMENTED();
+}
+
+void AlloyBaseWindow::Restore() {
+  NOTIMPLEMENTED();
+}
+
+void AlloyBaseWindow::SetBounds(const gfx::Rect& bounds) {
+  NOTIMPLEMENTED();
+}
+
+void AlloyBaseWindow::FlashFrame(bool flash) {
+  NOTIMPLEMENTED();
+}
+
+ui::ZOrderLevel AlloyBaseWindow::GetZOrderLevel() const {
+  return ui::ZOrderLevel::kNormal;
+}
+
+void AlloyBaseWindow::SetZOrderLevel(ui::ZOrderLevel order) {
+  NOTIMPLEMENTED();
+}
+
+// AlloyExtensionWindowController:
+
+AlloyExtensionWindowController::AlloyExtensionWindowController(
+    AlloyBrowserHostImpl* browser)
+    : WindowController(new AlloyBaseWindow(browser),
+                       Profile::FromBrowserContext(
+                           browser->GetBrowserContext())),
+      browser_(browser),
+      session_id_(SessionID::NewUnique()),
+      is_popup_(browser->browser_info()->is_popup()),
+      base_window_(static_cast<AlloyBaseWindow*>(window())) {
+  if (auto* web_contents = browser_->GetWebContents()) {
+    // Give the tab a window id so that |tab.windowId| matches this
+    // controller's |GetWindowId()|. Chrome-style browsers get this from the
+    // Browser object; Alloy browsers would otherwise report -1.
+    if (auto* session_tab_helper =
+            sessions::SessionTabHelper::FromWebContents(web_contents)) {
+      session_tab_helper->SetWindowID(session_id_);
+    }
+  }
+
+  extensions::WindowControllerList::GetInstance()->AddExtensionWindow(this);
+
+  if (auto* web_contents = browser_->GetWebContents()) {
+    if (auto* router = TabsEventRouterFor(profile())) {
+      router->TrackAlloyTab(*web_contents);
+    }
+  }
+}
+
+AlloyExtensionWindowController::~AlloyExtensionWindowController() {
+  if (LastFocused() == this) {
+    LastFocused() = nullptr;
+  }
+  if (auto* web_contents = browser_->GetWebContents()) {
+    if (auto* router = TabsEventRouterFor(profile())) {
+      router->UntrackAlloyTab(*web_contents);
+    }
+  }
+  extensions::WindowControllerList::GetInstance()->RemoveExtensionWindow(this);
+}
+
+void AlloyExtensionWindowController::OnFocused() {
+  base_window_->SetFocused(true);
+  LastFocused() = this;
+  NotifyWindowFocusChanged(/*has_focus=*/true);
+}
+
+void AlloyExtensionWindowController::OnDestroyed() {
+  destroyed_ = true;
+}
+
+int AlloyExtensionWindowController::GetWindowId() const {
+  return static_cast<int>(session_id_.id());
+}
+
+std::string AlloyExtensionWindowController::GetWindowTypeText() const {
+  return extensions::api::tabs::ToString(
+      is_popup_ ? extensions::api::tabs::WindowType::kPopup
+                : extensions::api::tabs::WindowType::kNormal);
+}
+
+void AlloyExtensionWindowController::SetFullscreenMode(
+    bool is_fullscreen,
+    const GURL& extension_url) const {
+  NOTIMPLEMENTED();
+}
+
+content::WebContents* AlloyExtensionWindowController::GetActiveTab() const {
+  return browser_->GetWebContents();
+}
+
+int AlloyExtensionWindowController::GetTabCount() const {
+  return browser_->GetWebContents() ? 1 : 0;
+}
+
+content::WebContents* AlloyExtensionWindowController::GetWebContentsAt(
+    int i) const {
+  return i == 0 ? browser_->GetWebContents() : nullptr;
+}
+
+bool AlloyExtensionWindowController::IsVisibleToTabsAPIForExtension(
+    const extensions::Extension* extension,
+    bool include_dev_tools_windows) const {
+  // Platform apps can only see their own windows.
+  if (extension && extension->is_platform_app()) {
+    return false;
+  }
+  return !destroyed_;
+}
+
+base::DictValue
+AlloyExtensionWindowController::CreateWindowValueForExtension(
+    const extensions::Extension* extension,
+    PopulateTabBehavior populate_tab_behavior,
+    extensions::mojom::ContextType context) const {
+  base::DictValue dict;
+
+  dict.Set(extensions::extension_misc::kId, session_id_.id());
+  dict.Set(kWindowTypeKey, GetWindowTypeText());
+  dict.Set(kFocusedKey, window()->IsActive());
+  dict.Set(kIncognitoKey, profile()->IsOffTheRecord());
+  dict.Set(kAlwaysOnTopKey,
+           window()->GetZOrderLevel() == ui::ZOrderLevel::kFloatingWindow);
+  dict.Set(kShowStateKey, kShowStateValueNormal);
+
+  const gfx::Rect bounds = window()->GetBounds();
+  dict.Set(kLeftKey, bounds.x());
+  dict.Set(kTopKey, bounds.y());
+  dict.Set(kWidthKey, bounds.width());
+  dict.Set(kHeightKey, bounds.height());
+
+  if (populate_tab_behavior == kPopulateTabs) {
+    dict.Set(extensions::ExtensionTabUtil::kTabsKey,
+             CreateTabList(extension, context));
+  }
+
+  return dict;
+}
+
+base::ListValue AlloyExtensionWindowController::CreateTabList(
+    const extensions::Extension* extension,
+    extensions::mojom::ContextType context) const {
+  base::ListValue tab_list;
+  if (auto* web_contents = browser_->GetWebContents()) {
+    tab_list.Append(
+        extensions::ExtensionTabUtil::CreateTabObject(
+            web_contents,
+            extensions::ExtensionTabUtil::GetScrubTabBehavior(
+                extension, context, web_contents),
+            extension)
+            .ToValue());
+  }
+  return tab_list;
+}
+
+bool AlloyExtensionWindowController::OpenOptionsPage(
+    const extensions::Extension* extension,
+    const GURL& url,
+    bool open_in_tab) {
+  NOTIMPLEMENTED();
+  return false;
+}
+
+bool IsAlloyWindowController(extensions::WindowController* controller) {
+  return dynamic_cast<AlloyExtensionWindowController*>(controller) != nullptr;
+}
+
+extensions::WindowController* GetAlloyWindowControllerFor(
+    content::WebContents* contents) {
+  auto base_browser = CefBrowserHostBase::GetBrowserForContents(contents);
+  if (!base_browser || !base_browser->IsAlloyStyle()) {
+    return nullptr;
+  }
+  return AlloyBrowserHostImpl::FromBaseChecked(base_browser)
+      ->extension_window_controller();
+}
+
+extensions::WindowController* LastFocusedAlloyWindowController(
+    content::BrowserContext* context) {
+  auto* controller = LastFocused();
+  if (!controller) {
+    return nullptr;
+  }
+  Profile* profile = Profile::FromBrowserContext(context);
+  if (profile && !profile->IsSameOrParent(controller->profile())) {
+    return nullptr;
+  }
+  return controller;
+}
+
+}  // namespace cef
