        {
            "hosts": ["wikipedia.org", "wikimedia.org", "wikidata.org",
                      "mediawiki.org", "wikibooks.org", "wikinews.org",
                      "wikiquote.org", "wikisource.org", "wikiversity.org",
                      "wikivoyage.org", "wiktionary.org"],
            "params": ["wprov"]
        },
        {
            "hosts": ["duckduckgo.com"],
            "params": ["t", "atb"]
        },
        {
            "hosts": ["yandex.*"],
            "params": ["clid", "rtt", "redircnt", "wiz_*", "yabs-*"]
        },
        {
            "hosts": ["medium.com"],
            "params": ["sk"]
        }
