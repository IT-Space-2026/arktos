            ]
        },
        {
            "hosts": ["reddit.com"],
            "params": [
                "ref_source", "ref_campaign", "correlation_id",
                "utm_name", "d2x_*"
            ]
        },
        {
            "hosts": ["ebay.*"],
            "params": [
                "_trkparms", "_trksid", "mkevt", "mkcid", "mkrid",
                "campid", "toolid", "customid"
            ]
        },
        {
            "hosts": ["twitch.tv"],
