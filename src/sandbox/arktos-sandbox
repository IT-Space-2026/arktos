#!/bin/sh
# arora-sandbox — start Arora inside the permissive bwrap
# filesystem sandbox.  Generated by
# BwrapGenerator::launcherScript() (src/sandbox/); the
# autotest asserts this file matches the generator output, so
# edit the generator rather than this file.
set -ef
bindir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
bwrap=${ARORA_BWRAP:-$(command -v bwrap 2>/dev/null || true)}
if [ -z "$bwrap" ] || [ -n "$ARORA_NO_SANDBOX" ]; then
    exec "$bindir/arora" "$@"
fi
nl='
'
wrap_args="--die-with-parent$nl--setenv${nl}ARORA_SANDBOXED${nl}bwrap"
wrap_args="$wrap_args$nl--dev-bind${nl}/${nl}/"
denied_dirs="
.ssh
.gnupg
.pki
.password-store
.netrc
.git-credentials
.local/share/keyrings
.aws
.azure
.kube
.docker
.config/gh
.mozilla
.thunderbird
.config/google-chrome
.config/chromium
.config/BraveSoftware
.config/microsoft-edge
.config/microsoft-edge-dev
.config/vivaldi
.config/opera
.config/epiphany
.local/share/epiphany
.config/falkon
.config/qutebrowser
Library/Keychains
Library/Application Support/Google/Chrome
Library/Application Support/Chromium
Library/Application Support/Firefox
Library/Application Support/BraveSoftware
"
read_only_roots="
/etc
/usr
/boot
"
IFS=$nl
for rel in $denied_dirs; do
    p=$HOME/$rel
    if [ -d "$p" ]; then
        wrap_args="$wrap_args$nl--tmpfs$nl$p"
    elif [ -e "$p" ] || [ -L "$p" ]; then
        wrap_args="$wrap_args$nl--ro-bind${nl}/dev/null$nl$p"
    fi
done
for root in $read_only_roots; do
    if [ -d "$root" ]; then
        wrap_args="$wrap_args$nl--ro-bind$nl$root$nl$root"
    fi
done
# IFS is still newline-only: $wrap_args splits into one
# positional parameter per line (space-safe), then "$@"
# appends the caller's arguments verbatim.
set -- $wrap_args -- "$bindir/arora" "$@"
unset IFS
exec "$bwrap" "$@"
