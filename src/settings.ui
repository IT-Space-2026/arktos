        <layout class="QHBoxLayout" name="containerSitesLayout">
         <item>
          <widget class="QListWidget" name="containerSitesList">
           <property name="accessibleName">
            <string>Sites assigned to the selected container</string>
           </property>
           <property name="selectionMode">
            <enum>QAbstractItemView::SingleSelection</enum>
           </property>
           <property name="uniformItemSizes">
            <bool>true</bool>
           </property>
          </widget>
         </item>
         <item>
          <layout class="QVBoxLayout" name="containerSitesButtonsLayout">
           <item>
            <widget class="QPushButton" name="containerSiteRemoveButton">
             <property name="enabled">
              <bool>false</bool>
             </property>
             <property name="text">
              <string>Remove Site</string>
             </property>
            </widget>
           </item>
           <item>
            <spacer name="containerSitesButtonSpacer">
             <property name="orientation">
              <enum>Qt::Vertical</enum>
             </property>
            </spacer>
           </item>
          </layout>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="containersDeleteHintLabel">
         <property name="text">
          <string>Deleting a container permanently removes all site data stored in it.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tab_downloads">
      <layout class="QVBoxLayout" name="downloadsPageLayout">
       <item>
        <widget class="QGroupBox" name="downloadEngineGroup">
         <property name="title">
          <string>Download Engine</string>
         </property>
         <layout class="QGridLayout" name="downloadEngineLayout" columnstretch="0,0,1">
          <item row="0" column="0">
           <widget class="QLabel" name="downloadEngineLabel">
            <property name="text">
             <string>Engine:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="downloadEngineCombo">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Maximum" vsizetype="Fixed">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="accessibleName">
             <string>Download engine</string>
            </property>
            <property name="toolTip">
             <string>Which backend transfers downloads. Accelerated needs a rustdl-enabled build; the external program option below overrides either engine.</string>
            </property>
            <item>
             <property name="text">
              <string>Built-in (Chromium)</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Accelerated (Rust)</string>
             </property>
            </item>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="downloadConnectionsLabel">
            <property name="text">
             <string>Connections per download:</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QSpinBox" name="downloadConnectionsSpin">
            <property name="accessibleName">
             <string>Connections per download</string>
            </property>
            <property name="toolTip">
             <string>Parallel segments used by the accelerated engine (4-16; 0 = engine default of 8)</string>
            </property>
            <property name="specialValueText">
             <string>Engine default (8)</string>
            </property>
            <property name="maximum">
             <number>16</number>
            </property>
           </widget>
          </item>
          <item row="2" column="0" colspan="3">
           <widget class="QCheckBox" name="downloadParallelSegments">
            <property name="accessibleName">
             <string>Parallel download segments</string>
            </property>
            <property name="toolTip">
             <string>Splits downloads on the built-in (Chromium) engine into parallel byte-range requests when the server accepts ranges. The engine flag latches at startup, so the change applies on the next launch; it also applies in Tor windows where the engine path stays proxied.</string>
            </property>
            <property name="text">
             <string>Parallel segments (built-in engine, applies at restart)</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="groupBox_2">
         <property name="title">
          <string>Downloads</string>
         </property>
         <layout class="QVBoxLayout" name="verticalLayout_2">
          <item>
           <widget class="QRadioButton" name="downloadAsk">
            <property name="text">
             <string>Ask for a destination each time</string>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="horizontalLayout">
            <item>
             <widget class="QRadioButton" name="downloadDestination">
              <property name="text">
               <string>Use this destination:</string>
              </property>
              <property name="checked">
               <bool>true</bool>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLineEdit" name="downloadsLocation">
              <property name="layoutDirection">
               <enum>Qt::LeftToRight</enum>
              </property>
              <property name="accessibleName">
               <string>Download directory</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="downloadDirectoryButton">
              <property name="sizePolicy">
               <sizepolicy hsizetype="Maximum" vsizetype="Fixed">
                <horstretch>0</horstretch>
                <verstretch>0</verstretch>
               </sizepolicy>
              </property>
              <property name="text">
               <string>Choose Directory...</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <layout class="QHBoxLayout" name="horizontalLayout_2">
            <item>
             <widget class="QCheckBox" name="externalDownloadButton">
              <property name="text">
               <string>Use this external download program:</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLineEdit" name="externalDownloadPath">
              <property name="accessibleName">
               <string>External download program</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="externalDownloadBrowse">
              <property name="sizePolicy">
               <sizepolicy hsizetype="Maximum" vsizetype="Fixed">
                <horstretch>0</horstretch>
                <verstretch>0</verstretch>
               </sizepolicy>
              </property>
              <property name="text">
               <string>Choose Program...</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <layout class="QHBoxLayout" name="downloadCleanupLayout">
            <item>
             <widget class="QLabel" name="downloadCleanupLabel">
              <property name="text">
               <string>Finished downloads list:</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="downloadCleanupCombo">
              <property name="sizePolicy">
               <sizepolicy hsizetype="Maximum" vsizetype="Fixed">
                <horstretch>0</horstretch>
                <verstretch>0</verstretch>
               </sizepolicy>
              </property>
              <property name="accessibleName">
               <string>Finished downloads list cleanup policy</string>
              </property>
              <item>
               <property name="text">
                <string>Keep entries</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Clear on application exit</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Remove each download when it finishes</string>
               </property>
              </item>
             </widget>
            </item>
            <item>
             <spacer name="downloadCleanupSpacer">
              <property name="orientation">
               <enum>Qt::Horizontal</enum>
              </property>
             </spacer>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <spacer name="downloadsPageSpacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
