          </item>
          <item row="4" column="0" colspan="3">
           <widget class="QCheckBox" name="blockThirdPartyCookies">
            <property name="toolTip">
             <string>Reject cookies set by embedded third-party content even when cookies are accepted generally. Per-site exceptions above still apply.</string>
            </property>
            <property name="text">
             <string>Block third-party cookies</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
