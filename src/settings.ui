       </item>
       <item>
        <widget class="QGroupBox" name="hardeningGroupBox">
         <property name="title">
          <string>Connections &amp;&amp; Storage</string>
         </property>
         <layout class="QVBoxLayout">
          <item>
           <widget class="QCheckBox" name="httpsFirst">
            <property name="toolTip">
             <string>Upgrade plain HTTP page loads to HTTPS when possible. Sites that fail the secure connection are allowed over HTTP again for the rest of the session — the error page says so.</string>
            </property>
            <property name="text">
             <string>Upgrade connections to HTTPS when possible</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="httpsOnly">
            <property name="toolTip">
             <string>Warn before a page loads over plain HTTP: any main-frame navigation that is still HTTP after the HTTPS upgrade pass shows a warning page instead of loading insecurely, offering proceed-once and always-allow choices per site. Localhost, LAN addresses and .onion names stay exempt.</string>
            </property>
            <property name="text">
             <string>Warn before loading a site over plain HTTP</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout">
            <item>
             <widget class="QLabel" name="refererPolicyLabel">
              <property name="toolTip">
               <string>Controls the Referer header other parties receive. Trimmed: other sites see only their own address — nothing about the page you came from — and same-site requests carry just the origin, never the full path or query. Strict sends nothing to other sites. Never withholds the header everywhere — referrer test pages grade that fully clean, but a few sites that require a Referer may break. Pages that withhold their own referer (noopener links, stricter site policies, insecure downgrades) always stay silent.</string>
              </property>
              <property name="text">
               <string>Referer header:</string>
              </property>
              <property name="buddy">
               <cstring>refererPolicy</cstring>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="refererPolicy">
              <property name="sizePolicy">
               <sizepolicy hsizetype="Maximum" vsizetype="Fixed">
                <horstretch>0</horstretch>
                <verstretch>0</verstretch>
               </sizepolicy>
              </property>
              <property name="toolTip">
               <string>Controls the Referer header other parties receive. Trimmed: other sites see only their own address — nothing about the page you came from — and same-site requests carry just the origin, never the full path or query. Strict sends nothing to other sites. Never withholds the header everywhere — referrer test pages grade that fully clean, but a few sites that require a Referer may break.</string>
              </property>
              <item>
               <property name="text">
                <string>Chromium default</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Trimmed (recommended)</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Strict — none to other sites</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Never send</string>
               </property>
              </item>
             </widget>
            </item>
            <item>
             <spacer name="refererPolicySpacer">
              <property name="orientation">
               <enum>Qt::Horizontal</enum>
              </property>
             </spacer>
            </item>
           </layout>
          </item>
          <item>
           <widget class="QCheckBox" name="webrtcProtection">
            <property name="toolTip">
             <string>Route WebRTC traffic through the configured proxy only, so voice/video sites cannot discover your local or real IP address. Takes effect after a restart; may break WebRTC apps.</string>
            </property>
            <property name="text">
             <string>Prevent WebRTC from exposing IP addresses</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout">
            <item>
             <widget class="QLabel" name="secureDnsLabel">
              <property name="text">
               <string>Secure DNS (DoH):</string>
              </property>
              <property name="buddy">
               <cstring>secureDnsMode</cstring>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="secureDnsMode">
              <property name="sizePolicy">
               <sizepolicy hsizetype="Maximum" vsizetype="Fixed">
                <horstretch>0</horstretch>
                <verstretch>0</verstretch>
               </sizepolicy>
              </property>
              <property name="toolTip">
               <string>DNS-over-HTTPS hides lookups from the local network's plain DNS. Automatic upgrades only when the network resolver is on Chromium's known-provider list; the Custom modes always use the endpoint below — the strict mode never falls back to plain DNS, so an unreachable endpoint stops name resolution entirely. The feature flag takes effect after a restart.</string>
              </property>
              <item>
               <property name="text">
                <string>Off (system resolver)</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Automatic upgrade</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Custom server (with system fallback)</string>
               </property>
              </item>
              <item>
               <property name="text">
                <string>Custom server (strict — no fallback)</string>
               </property>
              </item>
             </widget>
            </item>
            <item>
             <spacer name="secureDnsSpacer">
              <property name="orientation">
               <enum>Qt::Horizontal</enum>
              </property>
             </spacer>
            </item>
           </layout>
          </item>
          <item>
           <widget class="QLineEdit" name="secureDnsServer">
            <property name="enabled">
             <bool>false</bool>
            </property>
            <property name="toolTip">
             <string>DoH URI template used by the Custom modes, e.g. https://cloudflare-dns.com/dns-query or https://dns.google/dns-query. Invalid entries fall back to the default resolver rather than disabling DoH.</string>
            </property>
            <property name="accessibleName">
             <string>DNS-over-HTTPS server URI template</string>
            </property>
            <property name="placeholderText">
             <string>https://cloudflare-dns.com/dns-query</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="strictTlsCiphers">
            <property name="toolTip">
             <string>Advertise only forward-secret AEAD cipher suites in TLS connections — RSA key-exchange and CBC suites are never offered. Takes effect after a restart; ancient sites that require the removed suites will not load.</string>
            </property>
            <property name="text">
             <string>Offer only strong TLS cipher suites</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="blockPings">
            <property name="toolTip">
             <string>Drop navigator.sendBeacon beacons, &lt;a ping&gt; link-tracking pings and Content-Security-Policy violation reports — invisible uploads sites use to track what you click and where you go. CSP still protects you; only its telemetry reports are suppressed. Uncheck to let sites receive them again.</string>
            </property>
            <property name="text">
             <string>Block tracking pings and beacons</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="blockPrefetch">
            <property name="toolTip">
             <string>Drop prefetch and prerender hints (&lt;link rel=prefetch&gt;) — they fetch pages you may never visit, leaking connections and bandwidth to sites a link merely points at.</string>
            </property>
            <property name="text">
             <string>Block prefetch requests</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="dnsPrefetch">
            <property name="toolTip">
             <string>Resolve the address of every site a page merely links to, before you click — this sends the names of sites you never visit to the DNS resolver. Off by default; enabling it only speeds up link navigation slightly.</string>
            </property>
            <property name="text">
             <string>Prefetch DNS for linked sites</string>
            </property>
            <property name="checked">
             <bool>false</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="blockRemoteFonts">
            <property name="toolTip">
             <string>Drop downloadable web fonts — font requests fingerprint your GPU/OS text stack and contact third-party hosts on every visit. Local and system fonts still work, but sites relying on icon fonts may render wrong.</string>
            </property>
            <property name="text">
             <string>Block remote web fonts</string>
            </property>
            <property name="checked">
             <bool>false</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="blockThirdPartyWebSockets">
            <property name="toolTip">
             <string>Refuse WebSocket connections to hosts outside the page's own site — whether a cross-site socket connects or is refused leaks state the site can read about you (cross-site leak oracle). Off by default: chat widgets, feeds and other real-time features legitimately open cross-site sockets.</string>
            </property>
            <property name="text">
             <string>Block third-party WebSockets</string>
            </property>
            <property name="checked">
             <bool>false</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="clearOnExit">
            <property name="toolTip">
             <string>On quit, wipe history, cookies, site storage and caches — everything Clear Private Data covers. Sites you stay logged in to are signed out.</string>
            </property>
            <property name="text">
             <string>Clear browsing data when Arora exits</string>
            </property>
            <property name="checked">
             <bool>false</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="pdfGroupBox">
         <property name="title">
          <string>PDF Documents</string>
         </property>
         <layout class="QVBoxLayout">
          <item>
           <widget class="QCheckBox" name="pdfViewer">
            <property name="toolTip">
             <string>Open PDF links in Chromium's built-in PDFium viewer instead of downloading them — the parser runs inside the sandboxed renderer. Turn off to keep the old save-everything behavior.</string>
            </property>
            <property name="text">
             <string>Open PDFs in the built-in viewer</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="pdfSanitize">
            <property name="toolTip">
             <string>Before a fetched PDF reaches the viewer, a Rust policy pass rewrites it — removing JavaScript payloads, auto-execute triggers (OpenAction/AA), Launch commands, embedded files, XFA forms and remote-submit actions. Only the in-browser view is sanitized; saving a PDF still gives your external reader the original bytes.</string>
            </property>
            <property name="text">
             <string>Sanitize PDFs before viewing</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="fingerprintGroupBox">
         <property name="title">
          <string>Fingerprint Resistance</string>
         </property>
         <layout class="QVBoxLayout">
          <item>
           <widget class="QCheckBox" name="reportUtcTimezone">
            <property name="toolTip">
             <string>Websites see UTC as your timezone instead of the system's — Date and Intl API reads all report UTC. Takes full effect after a restart; pages already open keep their timezone.</string>
            </property>
            <property name="text">
             <string>Report UTC as the timezone</string>
            </property>
            <property name="checked">
             <bool>false</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="normalizeAcceptLanguage">
            <property name="toolTip">
             <string>Send 'en-US, en' as Accept-Language and navigator.languages instead of the configured list so every user looks alike. The Language list setting is preserved and used again when this is off.</string>
            </property>
            <property name="text">
             <string>Report generic language preferences (en-US, en)</string>
            </property>
            <property name="checked">
             <bool>false</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="fingerprintProtection">
            <property name="toolTip">
             <string>Inject countermeasures into web pages: canvas read-out noise, a generic WebGL vendor/renderer and normalized device values (cores, memory, plugins). This is opt-in noise, not anonymity — a site can still detect the spoofing and canvas-heavy pages can break; the shield button exempts a site that does. Always on in Tor windows.</string>
            </property>
            <property name="text">
             <string>Spoof canvas/WebGL fingerprints</string>
            </property>
            <property name="checked">
             <bool>false</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="permissionsGroupBox">
         <property name="title">
          <string>Site Permissions</string>
         </property>
         <layout class="QGridLayout" columnstretch="0,1">
          <item row="0" column="0" colspan="2">
           <widget class="QLabel" name="permissionsHintLabel">
            <property name="text">
             <string>Websites must ask before using notifications, geolocation or mouse lock. Capture devices and clipboard access are always denied. Remembered permission, JavaScript and pop-up decisions:</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
