             </property>
            </column>
            <column>
             <property name="text">
              <string>Decision</string>
             </property>
            </column>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QPushButton" name="permissionRemoveButton">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Maximum" vsizetype="Fixed">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="enabled">
             <bool>false</bool>
            </property>
            <property name="text">
             <string>Remove</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QPushButton" name="permissionClearAllButton">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Maximum" vsizetype="Fixed">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="text">
             <string>Clear All</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="credentialGroupBox">
         <property name="title">
          <string>Saved Passwords</string>
         </property>
         <layout class="QGridLayout" columnstretch="0,0,1">
          <item row="0" column="0" colspan="3">
           <widget class="QLabel" name="credentialStatusLabel">
