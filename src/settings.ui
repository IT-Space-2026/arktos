       <item>
        <layout class="QHBoxLayout" name="suspendTabsLayout">
         <item>
          <widget class="QCheckBox" name="suspendTabs">
           <property name="text">
            <string>Suspend inactive tabs after</string>
           </property>
          </widget>
         </item>
