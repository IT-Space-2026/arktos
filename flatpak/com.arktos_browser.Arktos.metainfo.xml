    <keyword>WWW</keyword>
    <keyword>Browser</keyword>
    <keyword>Web</keyword>
  </keywords>
  <url type="homepage">https://github.com/IT-Space-2026/arktos</url>
  <url type="bugtracker">https://github.com/IT-Space-2026/arktos/issues</url>
  <provides>
