  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>
  <name>Arktos</name>
  <summary>Experimental Qt 6 / QtWebEngine web browser</summary>
  <developer id="com.arktos_browser">
    <name>Janos Szenfner</name>
  </developer>
  <description>
    <p>
      Arktos is a Qt 6 / QtWebEngine (Chromium) web browser — a maintained
      continuation of the 2009 Qt/WebKit Arora rebuilt around privacy
      hardening, per-site containers, optional Tor windows and a
      Vivaldi-style UI with an icon-rail sidebar, two-level container tab
      strip, reader mode, rich download cards and a command palette.
    </p>
    <p>
      Arktos is experimental software and is provided as is.
    </p>
  </description>
  <launchable type="desktop-id">com.arktos_browser.Arktos.desktop</launchable>
